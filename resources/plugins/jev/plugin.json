{
  "name": "jev",
  "version": "0.2.0",
  "displayName": "Jev 判断台",
  "description": "明确材料与问题，按次确认结构化判断；连接及开关跨重启恢复，自动化独立授权。",
  "category": "AI",
  "brandColor": "#B7D2C5",
  "composerIcon": "./ui/icon.svg",
  "requirements": {
    "capabilities": [
      "mcp.stdio",
      "config.fields",
      "config.deferred",
      "jev.decisions.v2"
    ]
  },
  "config": {
    "startup": "deferred",
    "fields": [
      {
        "id": "api-key",
        "type": "secret",
        "label": "TypeSafe API 密钥",
        "purpose": "仅供 Jev 服务验证及你开启的判断请求使用；不发送给对话模型。",
        "required": true
      }
    ]
  },
  "mcp": {
    "command": "node",
    "args": [
      "./server.mjs"
    ]
  },
  "panels": [
    {
      "id": "main",
      "title": "Jev 判断台",
      "tool": "jev_show",
      "entry": "ui://jev/panel",
      "defaultSize": {
        "w": 1040,
        "h": 800
      }
    }
  ],
  "permissions": {
    "canvas": []
  }
}
