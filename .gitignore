node_modules/
out/
dist/
release/
*.tsbuildinfo
.DS_Store
._*
*.log

# 语音识别模型(sherpa-onnx，~88MB，本地下载/打包时经 extraResources 附带，不入库)
resources/models/
smoke-out/

# 仓库根目录不该有构建产物。这里出现过 10 个 —— 是 `asar extract-file` 的参数
# 被子命令解析成空值、导致解压落到了当前目录。挡一道，免得下次又混进提交。
/index.js
/index-*.js

# canvas_snapshot 的产物，随手拍的，不入库
screenshot/

# agent 审查的中间产物（可由 .plans/css-dup-auditor/parse_css.py 重新生成）
.plans/*/entries.json
.plans/*/dups.json

# 写码 agent 的隔离工作树（team_spawn 的 isolation: 'worktree'）。
# 不忽略的话，一派活用户的 git status 就多出一个 ?? .worktrees/ ——
# 而那里面是几棵完整的工作树，噪音极大。改动本身在各自的 eas-team/* 分支上，不会丢。
.worktrees/

# oh-my-pi 的独立二进制（每平台约 130MB，打包时经 extraResources 附带，不入库；
# 由 scripts/fetch-omp.mjs 按 resources/omp/manifest.json 下载并校 SHA256。
# manifest.json 与 THIRD-PARTY-NOTICES.txt 保持跟踪）
resources/omp/mac-*/
resources/omp/win-*/
resources/omp/THIRD-PARTY-NOTICES.txt
