{
  "name": "powerpoint",
  "version": "1.0.1",
  "displayName": "PowerPoint 演示",
  "description": "创建文本幻灯片、读取文字、按索引编辑文本并保留其余包内容；不提供图表和动画编辑或视觉渲染。",
  "category": "办公文档",
  "requirements": {
    "capabilities": [
      "mcp.stdio",
      "config.fields"
    ]
  },
  "config": {
    "fields": [
      {
        "id": "root",
        "type": "directory",
        "label": "演示文稿目录",
        "purpose": "读取和创建PPTX，覆盖须校验当前SHA256",
        "required": true,
        "access": "read-write"
      }
    ]
  },
  "mcp": {
    "command": "node",
    "args": [
      "./server.mjs"
    ]
  },
  "permissions": {
    "canvas": []
  }
}
