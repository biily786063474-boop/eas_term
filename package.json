{
  "name": "eas-term",
  "productName": "Eas-Term",
  "version": "0.4.45",
  "description": "多终端 + 项目文件浏览的桌面终端应用",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test 'src/**/*.test.ts' 'src/**/*.test.mjs'",
    "dist": "electron-vite build && COPYFILE_DISABLE=1 electron-builder --mac -c.directories.output=\"$HOME/Eas-Term-release\"",
    "dist:ci": "electron-vite build && electron-builder --publish never",
    "postinstall": "electron-rebuild -f -w node-pty",
    "check": "npm run typecheck && node scripts/check-accent-contrast.mjs && npm test"
  },
  "build": {
    "appId": "com.biily.easterm",
    "productName": "Eas-Term",
    "afterPack": "build/afterPack.js",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!**/._*",
      "!**/node_modules/node-pty/build/**"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/sherpa-onnx/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": "Zang Yawen (D4FVS6QJXV)",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "x64ArchFiles": "**/node_modules/node-pty/prebuilds/**"
    },
    "dmg": {
      "title": "Eas-Term ${version}",
      "background": "build/dmg-bg.png",
      "iconSize": 120,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 222,
          "type": "file"
        },
        {
          "x": 390,
          "y": 222,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eas-Term",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "extraResources": [
      {
        "from": "mcp",
        "to": "mcp"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "hooks",
        "to": "hooks"
      },
      {
        "from": "resources/agent-hooks",
        "to": "agent-hooks"
      }
    ],
    "afterSign": "build/notarize.js"
  },
  "dependencies": {
    "@codemirror/merge": "^6.12.2",
    "konva": "^9.3.22",
    "svgpath": "^2.6.0",
    "polygon-clipping": "^0.15.7",
    "imagetracerjs": "^1.2.6",
    "mp4-muxer": "^5.2.2",
    "node-pty": "^1.0.0",
    "react-konva": "^18.2.16",
    "sherpa-onnx": "^1.13.4"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^3.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "zustand": "^5.0.0"
  }
}
