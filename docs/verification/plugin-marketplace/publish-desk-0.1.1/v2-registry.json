    {
      "name": "jev",
      "displayName": "Jev 判断台",
      "description": "明确材料与问题，按次确认结构化判断；连接及开关跨重启恢复，自动化独立授权。",
      "category": "AI",
      "brandColor": "#B7D2C5",
      "iconDataUrl": "data:image/svg+xml;base64,",
      "version": "0.2.0",
      "url": "https://eas.biily.top/plugins/jev/jev-0.2.0.zip",
      "sha256": "8b1e72bb96b3bf912bb73516860031622faed726ab1e2b27dd22809b0e8655df",
      "size": 26816,
      "permissions": {
        "canvas": []
      },
      "requirements": {
        "capabilities": [
          "mcp.stdio",
          "config.fields",
          "config.deferred",
          "jev.decisions.v2"
        ]
      },
      "detail": {
        "summary": "可选的 TypeSafe 结构化判断：对给定材料回答明确的分类、是非或评分小问题。默认关闭，需自行连接 TypeSafe；每次调用先经宿主确认材料。",
        "scenarios": [
          "反馈分类、自定义是非问题",
          "时间线里程碑与项目建议的独立授权自动化"
        ],
        "steps": [
          "安装后获取并填写 TypeSafe 密钥，完成一次连接验证",
          "在判断台确认材料和问题后调用；自动化需单独授权"
        ],
        "capabilities": [
          {
            "title": "show",
            "description": "打开判断台、自动化与连接用量面板。",
            "kind": "tool",
            "tool": "jev_show"
          },
          {
            "title": "decide",
            "description": "已连接且开启后，经宿主按次确认材料再做一次结构化判断。",
            "kind": "tool",
            "tool": "jev_decide"
          }
        ],
        "dataUse": "启用并连接后，只把经你确认的材料和问题发送给 TypeSafe；未连接或暂停时不调用。凭证只存宿主加密凭证库。",
        "limitations": "需要 Eas-Term 0.4.115 或更新版本（宿主能力 jev.decisions.v2）；需要自行获取密钥；中文效果尚未评估；费用为估算不是账单。",
        "changelog": "0.2.0：判断台/自动化/连接与用量三页重做；公开工具收敛为 jev_show / jev_decide，旧工具名作为需确认的过渡别名；连接跨重启可信恢复；旧宿主拒绝安装。"
      }
    },
    {
      "name": "publish-desk",
      "displayName": "发布台",
      "description": "一次宣发按平台分成卡片：一键复制文案、在画布里打开各平台发布页（登录一次记住），最后由你本人点发布。插件不联网。",
      "category": "自媒体",
      "brandColor": "#A2B9E0",
      "iconDataUrl": "data:image/svg+xml;base64,",
      "version": "0.1.1",
      "url": "https://eas.biily.top/plugins/publish-desk/publish-desk-0.1.1.zip",
      "sha256": "1b58a3a15fe1509459773020df6e428463d8ea46b268f86b54fba2571feec0ab",
      "size": 49413,
      "permissions": {
        "canvas": []
      },
      "requirements": {
        "minHostVersion": "0.4.120",
        "capabilities": [
          "mcp.stdio"
        ]
      },
      "detail": {
        "summary": "一次宣发按平台分成卡片：AI 按各平台字数和规则写好文案，你一键复制、在画布里打开发布页粘贴，最后由你本人点发布。插件不联网，不替你登录或发帖。",
        "scenarios": [
          "同一条内容要发到小红书、抖音、视频号、知乎、B 站、X、Reddit 等多个平台",
          "发之前想先查一遍违禁词、绝对化用语和站外引流",
          "某篇因为某个词被限流，想记下来以后自动提醒"
        ],
        "steps": [
          "让 AI「把这次宣发做成发布台批次」，它会按平台各写一张卡片",
          "在发布台面板里点「复制」，再点「打开发布页」在画布里登录对应平台（登录一次会记住）",
          "粘贴、自己检查后点发布，回来把卡片标成「已发布」"
        ],
        "capabilities": [
          {
            "title": "平台清单",
            "description": "14 个平台的发布页地址、字数上限（标明是否官方核实）与注意事项。",
            "kind": "tool",
            "tool": "desk_platforms"
          },
          {
            "title": "新建批次",
            "description": "一次宣发建一个批次，每个平台一张卡片。",
            "kind": "tool",
            "tool": "desk_add_batch"
          },
          {
            "title": "改卡片",
            "description": "修改某个平台的文案；已发布的卡片不能改。",
            "kind": "tool",
            "tool": "desk_update_card"
          },
          {
            "title": "查看批次",
            "description": "列出批次，或查看一个批次的全部卡片和字数检查。",
            "kind": "tool",
            "tool": "desk_list"
          },
          {
            "title": "标记状态",
            "description": "草稿 / 待发 / 已发布（可附链接）/ 不发；只在你确认发出后才标已发布。",
            "kind": "tool",
            "tool": "desk_mark"
          },
          {
            "title": "违禁词检查",
            "description": "本地检查绝对化用语、承诺保证、站外引流、他平台名、外部链接和你记下的词；每条命中附依据和建议写法，只提示不替你删改。",
            "kind": "tool",
            "tool": "desk_check"
          },
          {
            "title": "词库",
            "description": "查看内置词库；记下让你被限流的词，以后自动提醒。",
            "kind": "tool",
            "tool": "desk_lexicon"
          },
          {
            "title": "归档",
            "description": "归档或取消归档批次，不删除。",
            "kind": "tool",
            "tool": "desk_archive"
          }
        ],
        "dataUse": "插件不联网。批次、卡片和你记下的词只存在本机的插件数据目录（publish-desk.json），不按项目分。打开的发布页是你自己在画布浏览器里登录的平台网页。",
        "limitations": "需要 Eas-Term 0.4.120 或更新版本（一键复制依赖新版宿主）。0.4.120 起已内置，市场里的是可独立更新的副本。平台字数上限部分没有官方说法，以发布页为准；违禁词命中是提示，不代表平台一定会处理。",
        "changelog": "0.1.0：首个版本。14 个平台卡片、一键复制与画布内打开发布页、本地违禁词检查与个人词库、配图检查。"
      }
    }
